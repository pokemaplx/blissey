# Per-host settings for docker-compose.yml. Copy to .env next to the compose file, or define
# the same variables in the application settings of Coolify/Portainer/...

# Host paths mounted into the container (absolute paths recommended).
# config.toml
BLISSEY_CONFIG_PATH=./config.toml
# logs, temp files and daily backups (data/logs, data/tmp, data/backups)
BLISSEY_DATA_PATH=./data
# Dragonite's log folder: dragonite.log and the rotated dragonite-*.gz files.
# Mounted read-only at /dragonite/logs, the default [dragonite] log_dir in config.toml.
DRAGONITE_LOGS=/opt/dragonite/logs
