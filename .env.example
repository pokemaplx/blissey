# Per-host settings for docker-compose.yml. Copy to .env next to the compose file.

# Timezone of the container: must match the database server (every bucket is computed from now()).
TZ=UTC

# Host folder that contains dragonite.log (and the rotated dragonite-*.gz files).
# Mounted read-only at /dragonite/logs, the default [dragonite] log_dir in config.toml.
DRAGONITE_LOGS=/opt/dragonite/logs
